{
 "format_version": "1.8.0",
 "render_controllers": {
  "controller.render.megamod_creeper": {
   "geometry": "(query.is_name_any('Mutant Creeper') || v.machines_mutant) ? Geometry.mutant : Geometry.default",
   "materials": [
    {
     "*": "Material.default"
    }
   ],
   "textures": [
    "query.is_name_any('Insomnia Creeper') ? (Texture.insomnia) : ((query.is_name_any('Mutant Creeper') || v.machines_mutant) ? Texture.mutant : Texture.default)"
   ],
   "overlay_color": {
    "r": "((variable.flash == 0.0) || (query.swelling_dir < 0.0)) ? this : 1.0",
    "g": "((variable.flash == 0.0) || (query.swelling_dir < 0.0)) ? this : 1.0",
    "b": "((variable.flash == 0.0) || (query.swelling_dir < 0.0)) ? this : 1.0",
    "a": "((variable.flash == 0.0) || (query.swelling_dir < 0.0)) ? this : 0.5"
   }
  }
 }
}