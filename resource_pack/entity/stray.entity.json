{
 "format_version": "1.26.0",
 "minecraft:client_entity": {
  "description": {
   "identifier": "minecraft:stray",
   "min_engine_version": "1.8.0",
   "materials": {
    "default": "stray",
    "overlay": "stray_clothes"
   },
   "textures": {
    "default": "textures/entity/skeleton/stray",
    "overlay": "textures/entity/skeleton/stray_overlay"
   },
   "geometry": {
    "default": "geometry.skeleton.stray.v1.8",
    "overlay": "geometry.stray.armor.v1.8"
   },
   "spawn_egg": {
    "texture": "spawn_egg_stray"
   },
   "scripts": {
    "pre_animation": [
     "v.machines_mutant = query.is_name_any('Mutant Stray');",
     "variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;",
     "variable.riding_y_offset_with_respect_to_player = 0.5;",
     "variable.riding_y_offset_on_vehicle_where_other_entites_can_stand = query.is_riding_any_entity_of_type('minecraft:minecart', 'minecraft:boat', 'minecraft:chest_boat') ? -3.0 : 0.0;",
     "variable.riding_y_offset = variable.riding_y_offset_with_respect_to_player + variable.riding_y_offset_on_vehicle_where_other_entites_can_stand;"
    ],
    "animate": [
     "look_at_target",
     "controller_move",
     "riding",
     "controller_holding",
     "controller_brandish_spear",
     "controller_charging",
     "attack",
     "controller_sneaking",
     "controller_bob",
     "controller_damage_nearby_mobs",
     "controller_bow_and_arrow",
     "controller_swimming",
     "controller_use_item_progress",
     "controller_skeleton_attack"
    ],
    "initialize": [
     "v.machines_mutant = 0.0;"
    ],
    "scale": "(1.0) * ((query.is_name_any('Mutant Stray') || v.machines_mutant) ? 1.8 : 1.0)"
   },
   "animations": {
    "look_at_target_default": "animation.humanoid.look_at_target.default",
    "look_at_target_gliding": "animation.humanoid.look_at_target.gliding",
    "look_at_target_swimming": "animation.humanoid.look_at_target.swimming",
    "move": "animation.humanoid.move",
    "riding.body": "animation.humanoid.riding.body",
    "riding.arms": "animation.humanoid.riding.arms",
    "riding.legs": "animation.humanoid.riding.legs",
    "holding": "animation.humanoid.holding",
    "brandish_spear": "animation.humanoid.brandish_spear",
    "charging": "animation.humanoid.charging",
    "attack.rotations": "animation.humanoid.attack.rotations",
    "sneaking": "animation.humanoid.sneaking",
    "bob": "animation.humanoid.bob",
    "damage_nearby_mobs": "animation.humanoid.damage_nearby_mobs",
    "bow_and_arrow": "animation.humanoid.bow_and_arrow",
    "swimming": "animation.zombie.swimming",
    "use_item_progress": "animation.humanoid.use_item_progress",
    "skeleton_attack": "animation.skeleton.attack",
    "look_at_target": "controller.animation.humanoid.look_at_target",
    "controller_move": "controller.animation.humanoid.move",
    "riding": "controller.animation.humanoid.riding",
    "controller_holding": "controller.animation.humanoid.holding",
    "controller_brandish_spear": "controller.animation.humanoid.brandish_spear",
    "controller_charging": "controller.animation.humanoid.charging",
    "attack": "controller.animation.humanoid.attack",
    "controller_sneaking": "controller.animation.humanoid.sneaking",
    "controller_bob": "controller.animation.humanoid.bob",
    "controller_damage_nearby_mobs": "controller.animation.humanoid.damage_nearby_mobs",
    "controller_bow_and_arrow": "controller.animation.humanoid.bow_and_arrow",
    "controller_swimming": "controller.animation.zombie.swimming",
    "controller_use_item_progress": "controller.animation.humanoid.use_item_progress",
    "controller_skeleton_attack": "controller.animation.skeleton.attack"
   },
   "render_controllers": [
    "controller.render.stray_clothes",
    "controller.render.stray"
   ],
   "enable_attachables": true
  }
 }
}