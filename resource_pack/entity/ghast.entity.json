{
 "format_version": "1.26.0",
 "minecraft:client_entity": {
  "description": {
   "identifier": "minecraft:ghast",
   "materials": {
    "default": "ghast"
   },
   "textures": {
    "default": "textures/entity/ghast/ghast",
    "shooting": "textures/entity/ghast/ghast_shooting"
   },
   "geometry": {
    "default": "geometry.ghast"
   },
   "spawn_egg": {
    "texture": "spawn_egg_ghast"
   },
   "animations": {
    "move": "animation.ghast.move",
    "controller_move": "controller.animation.ghast.move"
   },
   "render_controllers": [
    "controller.render.ghast"
   ],
   "scripts": {
    "animate": [
     "controller_move"
    ],
    "initialize": [
     "v.machines_mutant = 0.0;"
    ],
    "pre_animation": [
     "v.machines_mutant = query.is_name_any('Mutant Ghast');"
    ],
    "scale": "(1.0) * ((query.is_name_any('Mutant Ghast') || v.machines_mutant) ? 1.8 : 1.0)"
   }
  }
 }
}