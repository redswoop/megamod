{
 "format_version": "1.26.0",
 "minecraft:client_entity": {
  "description": {
   "identifier": "minecraft:blaze",
   "min_engine_version": "1.8.0",
   "materials": {
    "body": "blaze_body",
    "head": "blaze_head"
   },
   "textures": {
    "default": "textures/entity/blaze"
   },
   "geometry": {
    "default": "geometry.blaze"
   },
   "animations": {
    "look_at_target": "animation.common.look_at_target",
    "move": "animation.blaze.move",
    "controller_move": "controller.animation.blaze.move",
    "flame": "controller.animation.blaze.flame"
   },
   "particle_effects": {
    "charged_flames": "minecraft:mobflame_emitter"
   },
   "render_controllers": [
    "controller.render.blaze"
   ],
   "spawn_egg": {
    "texture": "spawn_egg_blaze"
   },
   "scripts": {
    "animate": [
     "controller_move",
     "flame"
    ],
    "initialize": [
     "v.machines_mutant = 0.0;"
    ],
    "pre_animation": [
     "v.machines_mutant = query.is_name_any('Mutant Blaze');"
    ],
    "scale": "(1.0) * ((query.is_name_any('Mutant Blaze') || v.machines_mutant) ? 1.8 : 1.0)"
   }
  }
 }
}